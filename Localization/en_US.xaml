<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- General / plugin -->
  <sys:String x:Key="LOCItchioMetadata_Name">itch.io Metadata</sys:String>

  <!-- Settings view -->
  <sys:String x:Key="LOCItchioMetadata_SettingsTitle">itch.io Metadata Provider Settings</sys:String>
  <sys:String x:Key="LOCItchioMetadata_PreferDescription">Prefer itch.io description over existing</sys:String>
  <sys:String x:Key="LOCItchioMetadata_DownloadScreenshots">Download screenshots for background images</sys:String>
  <sys:String x:Key="LOCItchioMetadata_PreferFirstSearchResult">Automatically use first search result (background mode)</sys:String>
  <sys:String x:Key="LOCItchioMetadata_PreferFirstSearchResultTooltip">When enabled, the first search result will be used automatically during background metadata downloads</sys:String>
  <sys:String x:Key="LOCItchioMetadata_MaxSearchResultsLabel">Max search results:</sys:String>
  <sys:String x:Key="LOCItchioMetadata_SettingsNote">Note: This plugin scrapes data from itch.io game pages. Make sure to respect itch.io&apos;s terms of service.</sys:String>

  <!-- Dialog titles -->
  <sys:String x:Key="LOCItchioMetadata_SelectGameDialogTitle">Select itch.io game</sys:String>
  <sys:String x:Key="LOCItchioMetadata_SelectBackgroundImageDialogTitle">Select background image</sys:String>

  <!-- Validation / errors -->
  <sys:String x:Key="LOCItchioMetadata_MaxSearchResultsValidation">Max search results must be between 1 and 100</sys:String>

  <!-- Scraper formatting and link labels -->
  <sys:String x:Key="LOCItchioMetadata_ByAuthorFormat">by {0}</sys:String>
  <sys:String x:Key="LOCItchioMetadata_DeveloperPageLink">Developer Page</sys:String>
  <sys:String x:Key="LOCItchioMetadata_LinkTwitter">Twitter</sys:String>
  <sys:String x:Key="LOCItchioMetadata_LinkDiscord">Discord</sys:String>
  <sys:String x:Key="LOCItchioMetadata_LinkGitHub">GitHub</sys:String>
  <sys:String x:Key="LOCItchioMetadata_LinkYouTube">YouTube</sys:String>
  <sys:String x:Key="LOCItchioMetadata_LinkSteam">Steam</sys:String>
  <sys:String x:Key="LOCItchioMetadata_LinkWebsite">Website</sys:String>

</ResourceDictionary>

